{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      "scripts/**",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      ".vscode/**",
      "**/node_modules/**",
      "functions/**",
      "firebase.json",
      "firestore.rules",
      "README.md"
    ]
  }
}
